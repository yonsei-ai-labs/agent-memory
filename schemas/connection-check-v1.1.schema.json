{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version",
    "intent",
    "memory_enabled",
    "benchmark",
    "worker",
    "user_simulator",
    "guards"
  ],
  "properties": {
    "profile_version": {
      "const": "1.1"
    },
    "intent": {
      "const": "connection_check"
    },
    "memory_enabled": {
      "const": false
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source_revision",
        "domain",
        "split",
        "task_id",
        "seed",
        "max_steps",
        "max_errors",
        "communicate_scorer",
        "localize_db"
      ],
      "properties": {
        "name": {
          "const": "tau2"
        },
        "source_revision": {
          "const": "c06b07dd7c4d4ec61ba6ff9bcdf0b15dd7ef36d4"
        },
        "domain": {
          "const": "airline"
        },
        "split": {
          "const": "train"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "const": 0
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "max_errors": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "communicate_scorer": {
          "const": "substring"
        },
        "localize_db": {
          "const": false
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "parameters",
        "provider",
        "forward_native_seed"
      ],
      "properties": {
        "model_id": {
          "const": "openai/gpt-6-luna"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reasoning",
            "max_completion_tokens",
            "seed"
          ],
          "properties": {
            "reasoning": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "effort"
              ],
              "properties": {
                "effort": {
                  "const": "low"
                }
              }
            },
            "max_completion_tokens": {
              "type": "integer",
              "minimum": 64,
              "maximum": 2048
            },
            "seed": {
              "const": 0
            }
          }
        },
        "provider": {
          "const": {
            "only": [
              "openai"
            ],
            "allow_fallbacks": false,
            "require_parameters": true
          }
        },
        "forward_native_seed": {
          "const": true
        }
      }
    },
    "user_simulator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "parameters",
        "provider",
        "forward_native_seed"
      ],
      "properties": {
        "model_id": {
          "const": "deepseek/deepseek-v4.1-flash-1017"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "temperature",
            "max_tokens",
            "reasoning"
          ],
          "properties": {
            "temperature": {
              "const": 0
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 64,
              "maximum": 512
            },
            "reasoning": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "const": false
                }
              }
            }
          }
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "only",
            "allow_fallbacks",
            "require_parameters"
          ],
          "properties": {
            "only": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "enum": [
                  "deepseek",
                  "fireworks"
                ]
              }
            },
            "allow_fallbacks": {
              "const": false
            },
            "require_parameters": {
              "const": true
            }
          }
        },
        "forward_native_seed": {
          "const": false
        }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_model_requests",
        "max_reported_cost_usd",
        "max_seconds"
      ],
      "properties": {
        "max_model_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "max_reported_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.25
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-memory-eval:connection-check:1.1",
  "title": "Bounded OpenRouter tau2 connection check with explicit role routes and native seed policy"
}
