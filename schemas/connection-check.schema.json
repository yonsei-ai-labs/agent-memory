{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version",
    "intent",
    "memory_enabled",
    "benchmark",
    "worker",
    "user_simulator",
    "guards",
    "provider"
  ],
  "properties": {
    "profile_version": {
      "const": "1.0"
    },
    "intent": {
      "const": "connection_check"
    },
    "memory_enabled": {
      "const": false
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source_revision",
        "domain",
        "split",
        "task_id",
        "seed",
        "max_steps",
        "max_errors",
        "communicate_scorer",
        "localize_db"
      ],
      "properties": {
        "name": {
          "const": "tau2"
        },
        "source_revision": {
          "const": "c06b07dd7c4d4ec61ba6ff9bcdf0b15dd7ef36d4"
        },
        "domain": {
          "const": "airline"
        },
        "split": {
          "const": "train"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "const": 0
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "max_errors": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "communicate_scorer": {
          "const": "substring"
        },
        "localize_db": {
          "const": false
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "parameters"
      ],
      "properties": {
        "model_id": {
          "const": "openai/gpt-6-luna"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reasoning",
            "max_completion_tokens",
            "seed"
          ],
          "properties": {
            "reasoning": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "effort"
              ],
              "properties": {
                "effort": {
                  "const": "low"
                }
              }
            },
            "max_completion_tokens": {
              "type": "integer",
              "minimum": 64,
              "maximum": 2048
            },
            "seed": {
              "const": 0
            }
          }
        }
      }
    },
    "user_simulator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "parameters"
      ],
      "properties": {
        "model_id": {
          "const": "openai/gpt-4.1"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "temperature",
            "max_completion_tokens",
            "seed"
          ],
          "properties": {
            "temperature": {
              "const": 0
            },
            "max_completion_tokens": {
              "type": "integer",
              "minimum": 64,
              "maximum": 512
            },
            "seed": {
              "const": 0
            }
          }
        }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_model_requests",
        "max_reported_cost_usd",
        "max_seconds"
      ],
      "properties": {
        "max_model_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "max_reported_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.25
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        }
      }
    },
    "provider": {
      "const": {
        "only": [
          "openai"
        ],
        "allow_fallbacks": false,
        "require_parameters": true
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-memory-eval:connection-check:1",
  "title": "Bounded OpenRouter tau2 connection check, not a research run plan"
}
