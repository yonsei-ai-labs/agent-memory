{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-memory-eval:memory-connection-check:1",
  "title": "Guided native tau2 memory roundtrip, separate from policy experiments",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version",
    "intent",
    "mode",
    "connection_profile_ref",
    "instructions",
    "policies",
    "guards"
  ],
  "properties": {
    "profile_version": {
      "const": "1.0"
    },
    "intent": {
      "const": "memory_connection_check"
    },
    "mode": {
      "const": "guided_check"
    },
    "connection_profile_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection_solve",
        "post_task_write",
        "probe_solve"
      ],
      "properties": {
        "collection_solve": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "post_task_write": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "probe_solve": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection",
        "probe"
      ],
      "properties": {
        "collection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "write_timing",
            "same_episode_read",
            "page_size",
            "read_mode",
            "max_items",
            "max_payload_bytes",
            "max_return_bytes"
          ],
          "properties": {
            "enabled": {
              "const": true
            },
            "write_timing": {
              "const": "post_task"
            },
            "same_episode_read": {
              "const": false
            },
            "page_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "read_mode": {
              "const": "none"
            },
            "max_items": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "max_payload_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "max_return_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "write_timing",
            "same_episode_read",
            "page_size",
            "read_mode",
            "max_items",
            "max_payload_bytes",
            "max_return_bytes"
          ],
          "properties": {
            "enabled": {
              "const": true
            },
            "write_timing": {
              "const": "none"
            },
            "same_episode_read": {
              "const": false
            },
            "page_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "read_mode": {
              "const": "on_demand"
            },
            "max_items": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "max_payload_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "max_return_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_model_requests",
        "max_reported_cost_usd",
        "max_seconds"
      ],
      "properties": {
        "max_model_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 48
        },
        "max_reported_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.25
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 360
        }
      }
    }
  }
}
