{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory.local/schemas/written-memory-comparison-v2.schema.json",
  "title": "Offline written-memory comparison draft v2; never a live profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "status",
    "executable",
    "question",
    "primary_comparison",
    "writing_result_ref",
    "replay_instruction_ref",
    "decision_source",
    "arms",
    "delivery",
    "control_notes",
    "cases",
    "analysis",
    "sampling",
    "guards",
    "paid_authorization",
    "unresolved",
    "research_coverage"
  ],
  "properties": {
    "format": {
      "const": "agent-memory-written-replay-draft/v2"
    },
    "status": {
      "const": "draft"
    },
    "executable": {
      "const": false
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "primary_comparison": {
      "type": [
        "string",
        "null"
      ]
    },
    "writing_result_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "replay_instruction_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "decision_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "log_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "log_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "arms": {
      "const": [
        "empty",
        "generic",
        "model_written",
        "researcher"
      ]
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "policy",
        "max_input_bytes",
        "scope",
        "memory_role",
        "position",
        "common_notice",
        "original_tools_and_parameters",
        "historical_system_note_replay"
      ],
      "properties": {
        "format": {
          "const": "past-memory-json-context/v1"
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "write_timing",
            "same_episode_read",
            "page_size",
            "read_mode",
            "max_items",
            "max_payload_bytes",
            "max_return_bytes"
          ],
          "properties": {
            "enabled": {
              "const": true
            },
            "write_timing": {
              "const": "none"
            },
            "same_episode_read": {
              "const": false
            },
            "page_size": {
              "type": "integer",
              "minimum": 1
            },
            "read_mode": {
              "const": "preload"
            },
            "max_items": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "max_payload_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "max_return_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "max_input_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "memory_role": {
          "const": "user"
        },
        "position": {
          "type": "integer",
          "const": 1
        },
        "common_notice": {
          "type": "string",
          "minLength": 1
        },
        "original_tools_and_parameters": {
          "type": "string",
          "minLength": 1
        },
        "historical_system_note_replay": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "control_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generic",
        "researcher"
      ],
      "properties": {
        "generic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "body",
            "origin",
            "information_access"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "type": "string",
              "minLength": 1
            },
            "origin": {
              "type": "string",
              "minLength": 1
            },
            "information_access": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "researcher": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "body",
            "origin",
            "information_access"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "type": "string",
              "minLength": 1
            },
            "origin": {
              "type": "string",
              "minLength": 1
            },
            "information_access": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "task_id",
          "repetition",
          "run_id",
          "request_id",
          "request_sha256",
          "response_sha256",
          "candidate_use",
          "selection_rule",
          "information_relation",
          "dependence_group",
          "automatic_screen",
          "selection"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "repetition": {
            "type": "integer",
            "minimum": 1
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "request_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "response_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "candidate_use": {
            "type": "string",
            "minLength": 1
          },
          "selection_rule": {
            "type": "string",
            "minLength": 1
          },
          "information_relation": {
            "type": "string",
            "minLength": 1
          },
          "dependence_group": {
            "type": "string",
            "minLength": 1
          },
          "automatic_screen": {
            "const": null
          },
          "selection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool",
              "request_ordinal",
              "expected_request_count"
            ],
            "properties": {
              "tool": {
                "const": "book_reservation"
              },
              "request_ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "expected_request_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_writer_allocations",
        "pairing",
        "decision_outcomes",
        "automatic_screen",
        "completion",
        "identity",
        "control_note_length",
        "semantic_annotation"
      ],
      "properties": {
        "all_writer_allocations": {
          "type": "string",
          "minLength": 1
        },
        "pairing": {
          "type": "string",
          "minLength": 1
        },
        "decision_outcomes": {
          "const": [
            "target_rule_correction",
            "new_error",
            "clarification",
            "read_or_defer",
            "unjudgeable"
          ]
        },
        "automatic_screen": {
          "type": "string",
          "minLength": 1
        },
        "completion": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "control_note_length": {
          "type": "string",
          "minLength": 1
        },
        "semantic_annotation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replay_repetitions",
        "schedule_seed",
        "power_and_cluster_plan"
      ],
      "properties": {
        "replay_repetitions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "schedule_seed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "power_and_cluster_plan": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_model_requests",
        "max_reported_cost_usd",
        "max_seconds",
        "timeout_seconds"
      ],
      "properties": {
        "max_model_requests": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "max_reported_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "max_seconds": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "timeout_seconds": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      }
    },
    "paid_authorization": {
      "const": null
    },
    "unresolved": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "research_coverage": {
      "const": {
        "comparison_kind": "common_experience_retrospective_diagnostic",
        "source_scope": "one_shared_customer_development_group",
        "primary_unit": "source_and_writer_bank_not_preparation_row",
        "natural_policy_effect_measured": false,
        "episode_success_measured": false,
        "autonomous_retrieval_measured": false,
        "held_out_transfer_measured": false,
        "common_baselines": {
          "no_memory_repetitions": "required_in_later_episode_comparison",
          "original_experience_access": "required_in_later_writing_comparison",
          "plain_summary": "required_in_later_writing_comparison"
        },
        "diagnostic_controls": [
          "empty",
          "generic",
          "researcher"
        ],
        "preserved_research_axes": [
          "during_and_post_task_writing",
          "own_and_mixed_banks",
          "write_read_cross",
          "retry_and_transfer",
          "continual_and_checkpoint_probes",
          "gains_regressions_and_full_cost"
        ],
        "positive_effect_required_to_continue": false
      }
    }
  }
}
