{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "journal_version",
    "commit_seq",
    "prev_sha256",
    "record_sha256",
    "operation",
    "events",
    "experiment_id",
    "state_ref"
  ],
  "properties": {
    "journal_version": {
      "const": "1.1"
    },
    "commit_seq": {
      "type": "integer",
      "minimum": 1
    },
    "prev_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "record_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "operation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_id",
            "request_sha256",
            "result_ref"
          ],
          "properties": {
            "operation_id": {
              "type": "string",
              "minLength": 1
            },
            "request_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "result_ref": {
              "$ref": "#/$defs/artifact"
            }
          }
        }
      ]
    },
    "events": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "urn:agent-memory-eval:event:1.1"
      }
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "state_ref": {
      "$ref": "#/$defs/artifact"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-memory-eval:journal:1.1",
  "title": "Single writer journal with immutable internal state v1.1",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "media_type"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
