{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-memory-eval:delivery-comparison:1.0",
  "title": "Frozen-bank task and delivery comparison v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version",
    "intent",
    "status",
    "connection_profile_ref",
    "memory_instruction_ref",
    "conditions",
    "tasks",
    "repetitions",
    "schedule_seed",
    "frozen_source",
    "preload_query_tools",
    "primary_comparison",
    "memory_limits",
    "guards"
  ],
  "properties": {
    "profile_version": {
      "const": "1.0"
    },
    "intent": {
      "const": "frozen_bank_delivery_comparison"
    },
    "status": {
      "enum": [
        "draft",
        "ready"
      ]
    },
    "connection_profile_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "memory_instruction_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "no_memory",
          "empty_bank",
          "on_demand",
          "full_preload"
        ]
      }
    },
    "tasks": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source_group_id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source_group_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "repetitions": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "schedule_seed": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "frozen_source": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "log_sha256",
            "experiment_id",
            "snapshot_id",
            "source_run_id"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "log_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "experiment_id": {
              "type": "string",
              "minLength": 1
            },
            "snapshot_id": {
              "type": "string",
              "minLength": 1
            },
            "source_run_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "preload_query_tools": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "primary_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "treated"
      ],
      "properties": {
        "baseline": {
          "enum": [
            "no_memory",
            "empty_bank",
            "on_demand",
            "full_preload"
          ]
        },
        "treated": {
          "enum": [
            "no_memory",
            "empty_bank",
            "on_demand",
            "full_preload"
          ]
        }
      }
    },
    "memory_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_size",
        "max_items",
        "max_payload_bytes",
        "max_return_bytes"
      ],
      "properties": {
        "page_size": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "max_items": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_payload_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_return_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "guards": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_model_requests",
            "max_reported_cost_usd",
            "max_seconds"
          ],
          "properties": {
            "max_model_requests": {
              "type": "integer",
              "minimum": 1
            },
            "max_reported_cost_usd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_seconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
