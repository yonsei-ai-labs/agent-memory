    "source": "import hashlib,json,subprocess,time\nfrom pathlib import Path\nfrom agent_memory_eval.contracts.core import canonical\nfrom agent_memory_eval.analysis.tau2_baseline import audit_baseline\nfrom agent_memory_eval.analysis.tau2_delivery import audit_delivery\nfrom agent_memory_eval.runner.decision_replay import audit_replay\nfrom agent_memory_eval.analysis.decision_replay import screen_reply\nOUT=Path('outputs/runtime-edge-fixes-20261116')\ndef sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()\nchecks=[]\nfor name,folder,receipt,fn in [('decision_replay','tau2-decision-replay-luna-120-01','20261116-decision-replay-results.json',audit_replay),('baseline','tau2-baseline-luna-deepseek1017-train-01','20261115-tau2-baseline-screening-results.json',audit_baseline),('delivery','tau2-delivery-luna-deepseek1017-development-01','20261114-tau2-delivery-development-results.json',audit_delivery)]:\n root=Path('runs')/folder;before=sha(root/'log.jsonl');start=time.perf_counter();result=fn(root);expected=json.loads((Path('artifacts/pilots')/receipt).read_bytes())['audit']\n if name=='delivery':\n  for key in ('experiment_id','audit_status','log_sha256','summary_sha256'):assert result[key]==expected[key],key\n else:assert canonical(result)==canonical(expected),name\n assert sha(root/'log.jsonl')==before\n full=OUT/(name+'-audit.json');full.write_bytes(canonical(result)+b'\\n')\n row=dict(experiment=name,status='passed',matches_preserved_audit=True,elapsed_seconds=time.perf_counter()-start,audit_sha256=hashlib.sha256(canonical(result)).hexdigest(),raw_log_sha256=before,source_log_unchanged=True,legacy_stop_reason=result.get('stop_reason'),reported_cost_usd=result['reported_cost_usd_decimal'],full_result_ref=dict(path=str(full),sha256=sha(full)))\n checks.append(row);(OUT/'compatibility.json').write_text(json.dumps(checks,indent=2)+'\\n');print(json.dumps(row),flush=True)\ndb_path=Path('data/tau2-bench/data/tau2/domains/airline/db.json');db=json.loads(db_path.read_bytes());flights=db['flights'];single=[];pairs=[]\ndef screen(legs,data):\n return screen_reply('21',dict(tool_calls=[dict(id='synthetic-order-check',function=dict(name='update_reservation_flights',arguments=json.dumps(dict(flights=legs))))]),data)['status']\nfor number,flight in flights.items():\n status=screen([dict(flight_number=number,date='2024-05-20')],db);assert status=='argument_check_passed',(number,status);single.append(status)\n if '+' in flight['scheduled_arrival_time_est']:\n  probe=dict(flights={number:flight,'__return__':dict(scheduled_departure_time_est='23:59:59',scheduled_arrival_time_est='00:59:59')})\n  for date,wanted in [('2024-05-20','violation_detected'),('2024-05-21','argument_check_passed')]:\n   status=screen([dict(flight_number=number,date='2024-05-20'),dict(flight_number='__return__',date=date)],probe);assert status==wanted,(number,date,status);pairs.append(status)\nclock=dict(status='passed',scope='Synthetic narrow time-order checks only, no business tools or model calls.',db_ref=dict(path=str(db_path),sha256=sha(db_path)),source_flights=len(single),next_day_arrivals=len(pairs)//2,same_day_returns_flagged=pairs.count('violation_detected'),next_day_returns_passed=pairs.count('argument_check_passed'))\n(OUT/'clock-coverage.json').write_text(json.dumps(clock,indent=2)+'\\n');print(json.dumps(clock),flush=True)\n"
